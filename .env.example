# Copy to .env for local development. npm dev/start/db commands load it.
# These public local-only defaults match docker/compose.postgres.yml.
# Existing process environment variables take precedence. Restart after edits.
# Deployments must supply their own private DATABASE_URL; never commit .env.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://leetkob:leetkob_local@127.0.0.1:5433/leetkob
