# Copy to deploy/.env on the VPS only. Never commit deploy/.env or real values.
# Tip: without a custom domain, set LEETKOB_SITE=70.153.86.114.sslip.io for automatic HTTPS.
LEETKOB_SITE=
POSTGRES_USER=leetkob
POSTGRES_PASSWORD=
POSTGRES_DB=leetkob
TRUST_PROXY=172.28.0.0/24

# Worker / LLM settings (never passed to api, postgres or sandbox containers)
MODEL_API_KEY=
MODEL_TIMEOUT_MS=30000
SANDBOX_IMAGE=leetkob-sandbox:pa03
WORKER_RETRY_BACKOFF_MS=500

# Isolated 5-account deployment seed passwords (15-128 chars, never password123)
DEPLOY_ADMIN_PASSWORD=
DEPLOY_TA1_PASSWORD=
DEPLOY_TA2_PASSWORD=
DEPLOY_STUDENT1_PASSWORD=
DEPLOY_STUDENT2_PASSWORD=
